<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Reading the currently connected Wi-Fi SSID requires fine location on
         Android (SSID is treated as location-sensitive), even though this app
         only uses it to compare against the configured home-network name.
         Android 12+ requires COARSE alongside FINE (the user can still only
         grant COARSE via the system dialog — the app's own permission check
         requires FINE specifically and degrades gracefully if only COARSE
         was granted). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Life map's periodic background capture (Settings → Location
         History): a distinct runtime permission from API 29 on, only
         requestable after foreground location is already granted, and only
         via a deep link to the app's own system Settings page (not a normal
         permission dialog) — see LocationHistorySettingsScreen. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- On newer Android versions, unredacted Wi-Fi info (real SSID, not
         "<unknown ssid>") also requires this even with location granted.
         neverForLocation: this app only ever compares the SSID string
         against a configured value, never derives physical location from
         Wi-Fi scan results. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- For scanning the WireGuard config QR code; never used for anything else. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Notifications infrastructure (Issue #1). POST_NOTIFICATIONS is a
         normal runtime-dialog permission on API 33+; below that, showing a
         notification just works without any prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact-time daily reminders (not WorkManager's approximate periodic
         work) need this. Not a runtime dialog — checked via
         AlarmManager.canScheduleExactAlarms() and, if false, the user is
         sent to the system settings screen for it. Mostly auto-granted on
         API 34+; a no-op concept below API 31. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- So a scheduled reminder survives a reboot (exact alarms don't). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".UrsApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Urs">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Notification-tap deep links (Issue #1). Custom scheme, not
                 an https App Link — purely internal navigation, no domain
                 verification needed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="urs" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.PortraitCaptureActivity"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".notifications.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- exported=true is required for BOOT_COMPLETED — the system, not
             another app, is what delivers this broadcast. -->
        <receiver
            android:name=".notifications.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
