<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Reading the currently connected Wi-Fi SSID requires fine location on
         Android (SSID is treated as location-sensitive), even though this app
         only uses it to compare against the configured home-network name.
         Android 12+ requires COARSE alongside FINE (the user can still only
         grant COARSE via the system dialog — the app's own permission check
         requires FINE specifically and degrades gracefully if only COARSE
         was granted). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- On newer Android versions, unredacted Wi-Fi info (real SSID, not
         "<unknown ssid>") also requires this even with location granted.
         neverForLocation: this app only ever compares the SSID string
         against a configured value, never derives physical location from
         Wi-Fi scan results. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- For scanning the WireGuard config QR code; never used for anything else. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".UrsApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Urs">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.PortraitCaptureActivity"
            android:screenOrientation="portrait" />

    </application>

</manifest>
