<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: permits cleartext HTTP to 10.0.2.2, the emulator's alias
     for the host machine's own loopback, for pointing a debug build at a
     backend running locally on the developer's machine (no local TLS
     cert). Never merged into the release manifest. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
